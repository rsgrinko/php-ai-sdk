{
    "name": "rsgrinko/ai-sdk",
    "description": "Лёгкий PHP SDK для агентов с вызовом инструментов поверх OpenAI-совместимых API (DeepSeek, OpenAI, OpenRouter, Ollama, llama.cpp)",
    "type": "library",
    "license": "MIT",
    "keywords": ["ai", "llm", "agent", "tool-calling", "function-calling", "openai", "deepseek", "ollama", "llama.cpp"],
    "homepage": "https://github.com/rsgrinko/php-ai-sdk",
    "authors": [
        {
            "name": "rsgrinko",
            "homepage": "https://github.com/rsgrinko"
        }
    ],
    "support": {
        "issues": "https://github.com/rsgrinko/php-ai-sdk/issues",
        "source": "https://github.com/rsgrinko/php-ai-sdk"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-pdo": "Для инструмента sql_query (DatabaseTool)",
        "ext-pdo_mysql": "Для DatabaseTool::mysql()"
    },
    "autoload": {
        "psr-4": {
            "Rsgrinko\\AiSdk\\Tools\\": "tools/",
            "Rsgrinko\\AiSdk\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
