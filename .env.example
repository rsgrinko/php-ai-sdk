# Адрес OpenAI-совместимого API (без /chat/completions).
#   DeepSeek          https://api.deepseek.com
#   OpenAI            https://api.openai.com/v1
#   OpenRouter        https://openrouter.ai/api/v1
#   Ollama (локально) http://localhost:11434/v1
#   llama.cpp         http://localhost:8080/v1
AI_BASE_URL=https://api.deepseek.com

# Модель: deepseek-chat / deepseek-flash / deepseek-reasoner / gpt-4o-mini / ...
AI_MODEL=deepseek-chat

# Ключ API. Для Ollama и llama.cpp не нужен — оставьте пустым.
AI_API_KEY=

# Таймаут одного запроса к модели, секунды.
AI_TIMEOUT=30

AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# Только для DeepSeek: отключить «размышления» — быстрее и дешевле.
# Для OpenAI, OpenRouter, Ollama оставьте false: лишнее поле может дать HTTP 400.
AI_DISABLE_THINKING=false

# Проверка TLS-сертификата. true — безопасно, так и должно быть в проде.
# false — только для локальной отладки (например, на Windows у PHP нет CA-бандла).
# Действует и для запросов к модели, и для HTTP-инструментов (Http::get).
AI_VERIFY_SSL=true

# Свой CA-бандл (cacert.pem). Пусто — системные сертификаты PHP/OpenSSL.
# Актуально для Windows: скачайте https://curl.se/ca/cacert.pem и укажите путь.
AI_CAINFO=

# === Агент ===

# Сколько раундов «модель → инструменты» разрешено до принудительного ответа.
AI_MAX_ROUNDS=5

# Разрешить модели возвращать несколько tool_calls в одном ответе.
# false — вызовы пойдут по одному (полезно для слабых моделей и опасных инструментов).
AI_PARALLEL_TOOL_CALLS=true

# Сколько сообщений истории держать перед вопросом (0 — без лимита).
# Старые ходы обрезаются целиком, system и текущий вопрос сохраняются.
AI_HISTORY_LIMIT=40

# auto — решает модель | none — не вызывать инструменты |
# required — обязать вызвать хоть что-то | имя_инструмента — заставить конкретный.
AI_TOOL_CHOICE=auto

# Имя инструмента, которым модель завершает работу (см. Tools\FinishTool).
# Пусто — не перехватывать: finish станет обычным инструментом.
AI_FINISH_TOOL=finish
